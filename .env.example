# Copy to .env and fill in. .env is gitignored.

# --- Auth ---
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Never commit the real value.
SECRET_KEY=change-me-in-production

# --- News sources ---
# Optional. If unset, Finnhub fetcher is skipped; yfinance + Yahoo RSS are used.
# Get a free key at https://finnhub.io/
FINNHUB_API_KEY=

# --- Database ---
# Path to the SQLite database file. Relative paths resolve from the project root.
# FINBRIEF_DB=data/finbrief.db

# --- Scheduler ---
# Wall-clock time (HH:MM, 24-hour local) for the daily pipeline run.
# REFRESH_TIME=07:00

# --- Urgency-spike thresholds ---
# A ticker is flagged when today's score drops more than SPIKE_SIGMA standard
# deviations below its 14-day rolling mean AND has at least MIN_NEG_HEADLINES
# high-confidence (>=0.7) negative headlines.
# SPIKE_SIGMA=1.5
# MIN_NEG_HEADLINES=2

# --- Fetch retries ---
# Number of attempts per source per ticker before giving up (2s/4s/... backoff).
# FETCH_RETRIES=3
# FETCH_RETRY_DELAY=2.0
